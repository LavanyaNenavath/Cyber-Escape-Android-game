<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="24dp"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/win_title"
        android:textColor="@color/cyber_green"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/win_subtitle"
        android:textColor="@color/neon_cyan"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/btnPlayAgain"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:text="@string/btn_play_again"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"/>

    <Button
        android:id="@+id/btnMainMenuWin"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:text="@string/btn_main_menu"
        android:textSize="18sp"
        android:layout_marginTop="16dp"/>

</LinearLayout>
