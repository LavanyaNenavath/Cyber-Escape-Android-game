<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#000814">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT LEVEL"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#00E676"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnLevel1"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="LEVEL 1 - PASSWORD BREACH"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00E676" />

    <TextView
        android:id="@+id/txtLevel1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔓 UNLOCKED"
        android:textColor="#00E676"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnLevel2"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="LEVEL 2 - VULNERABILITY HUNT"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00695C" />

    <TextView
        android:id="@+id/txtLevel2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 LOCKED (Complete Level 1)"
        android:textColor="#B0BEC5"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnLevel3"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="LEVEL 3 - STOP THE ATTACK"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00695C" />

    <TextView
        android:id="@+id/txtLevel3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 LOCKED (Complete Level 2)"
        android:textColor="#B0BEC5"
        android:layout_marginTop="8dp" />

</LinearLayout>